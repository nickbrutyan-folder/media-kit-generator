# Counter + X profile API (server/) — these are read by server/index.js
# Copy to .env on the VPS (never commit the real .env)

# Port the Express counter API listens on (localhost only; Nginx proxies /api/* to this)
PORT=3101

# Secret key for the private /api/stats and /api/x/usage endpoints.
# Generate a random value, e.g.:  openssl rand -hex 32
STATS_KEY=change-me-to-a-random-value

# Sorsa.io API key — enables /api/x/profile auto-fill via the Sorsa /info
# and /user-tweets endpoints. Without it, that endpoint returns 503.
# Sign up and grab your key at https://sorsa.io/
SORSA_API_KEY=

# Path to the SQLite file that stores kit-generation rows + Sorsa profile cache.
# Defaults to ./data/mediakit.db if unset.
# DATABASE_PATH=/var/lib/mediakit/mediakit.db
